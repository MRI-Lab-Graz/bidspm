# BIDSPM Container for MRI Lab Graz
# Author: Karl Koschutnig
# Organization: MRI Lab Graz
# Features: Python slim base, Octave, BIDSPM 4.0, SPM 26, UV package manager

FROM python:3.12-slim-trixie

LABEL maintainer="Karl Koschutnig <karl.koschutnig@uni-graz.at>"
LABEL description="BIDSPM container with Python slim base, Octave 9.x, BIDSPM 4.0, and SPM 26"
LABEL version="2025.1"
LABEL author="Karl Koschutnig"
LABEL organization="MRI Lab Graz"
# Standard OCI labels: GHCR uses org.opencontainers.image.source to link this
# published package back to the repo it was built from (Packages sidebar,
# provenance, etc).
LABEL org.opencontainers.image.source="https://github.com/MRI-Lab-Graz/bidspm"
LABEL org.opencontainers.image.description="BIDSPM container: Octave 9.x, BIDSPM 4.0, SPM 26, with lab bug-fix overrides baked in"

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV NODE_NO_WARNINGS=1

# Install system dependencies with performance optimizations
RUN apt-get update -qq && \
    apt-get -qq -y --no-install-recommends install \
        ca-certificates \
        curl \
        wget \
        git \
        unzip \
        python3 \
        python3-pip \
        python3-venv \
        octave \
        octave-common \
        octave-dev \
        octave-io \
        octave-image \
        octave-signal \
        octave-statistics \
        octave-struct \
        octave-parallel \
        octave-control \
        octave-symbolic \
        nodejs \
        npm \
        build-essential \
        patch \
        vim \
        nano \
        libblas3 \
        liblapack3 \
        libopenblas0 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

    # Install UV for fast Python package management
    RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
        mv /root/.local/bin/uv /usr/local/bin/uv && \
        chmod +x /usr/local/bin/uv
    
    # Install Python packages using UV (no PEP 668 issues with python:slim base)
    RUN uv pip install --system --no-cache-dir \
        numpy \
        scipy \
        matplotlib \
        pandas \
        nibabel \
        nilearn \
        bids-validator \
        pybids \
        jsonschema \
        setuptools \
        wheel
    
# Install SPM (released tag, built for Octave -- bin/spm-octave and the
# PLATFORM=octave build are supported in-tree since SPM25, no patch needed).
ARG SPM_TAG=26.10.01
RUN mkdir -p /opt/spm && \
    curl -fsSL https://github.com/spm/spm/archive/refs/tags/${SPM_TAG}.tar.gz | tar -xzC /opt/spm --strip-components=1 && \
    make -C /opt/spm/src PLATFORM=octave distclean && \
    make -C /opt/spm/src PLATFORM=octave && \
    make -C /opt/spm/src PLATFORM=octave install && \
    echo "✅ SPM ${SPM_TAG} installed and compiled for Octave successfully"

# Octave 9 does not implement `which -all` and warns on every call; SPM's bundled
# FieldTrip shims call it on each use. Octave only returns the first hit either way.
RUN grep -rlE "which *\(mfilename, *'-all'\)" /opt/spm/external | xargs sed -i -E "s/which\(mfilename, *'-all'\)/which(mfilename)/" && \
    ! grep -rqE "which *\(mfilename, *'-all'\)" /opt/spm/external

# Real BIDS validator (bidspm's bids.validate shells out to `bids-validator`).
RUN npm install -g bids-validator@1.14.10 && npm cache clean --force

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash neuro && \
    mkdir -p /home/neuro && \
    chown -R neuro:neuro /home/neuro && \
    chown -R neuro:neuro /opt/spm

    # Install BIDSPM 4.0 (stable release with submodules and Python CLI) as root
    RUN git clone --depth 1 --branch v4.0.0 https://github.com/cpp-lln-lab/bidspm.git /home/neuro/bidspm || \
        git clone --depth 1 https://github.com/cpp-lln-lab/bidspm.git /home/neuro/bidspm && \
        cd /home/neuro/bidspm && \
        git submodule update --init --recursive || true && \
        echo "✅ BIDSPM 4.0 installed successfully"

    # MarsBaR (bundled via CPP_ROI) maps only spm99/2/5/8/12 to a compat dir; SPM25+
    # has no dir of its own and spm5's covers it (verified: bidspm initialises on SPM26).
    RUN sed -i "s/case {'spm8', 'spm12b', 'spm12'}/case {'spm8', 'spm12b', 'spm12', 'spm25', 'spm26'}/" \
        /home/neuro/bidspm/lib/CPP_ROI/lib/marsbar/marsbar/marsbar.m && \
        grep -q "'spm26'" /home/neuro/bidspm/lib/CPP_ROI/lib/marsbar/marsbar/marsbar.m

    # The stats report template needs designType / OS.version, which bidspm never
    # sets; octache's per-key 'warn' output is the only visible effect.
    RUN sed -i "s/'warn', true/'warn', false/" /home/neuro/bidspm/src/reports/boilerplate.m && \
        grep -q "'warn', false" /home/neuro/bidspm/src/reports/boilerplate.m

    # marsbar('splash') needs a figure (the image has no graphics toolkit) and prints
    # "Cannot open display" on every run; the splash screen is cosmetic only.
    RUN sed -i "/marsbar('splash');/d" /home/neuro/bidspm/lib/CPP_ROI/initCppRoi.m && \
        ! grep -q "marsbar('splash')" /home/neuro/bidspm/lib/CPP_ROI/initCppRoi.m

    # Containers are run with --user <host uid>:<host gid> so writes into
    # host-owned bind mounts (e.g. derivatives/) work regardless of the
    # host's uid; that no longer matches the uid that owns this git clone,
    # which git treats as a "dubious ownership" security risk. This is a
    # system-wide (not per-uid) config, so it applies whatever uid runs.
    RUN git config --system --add safe.directory /home/neuro/bidspm
    
    # Install BIDSPM Python CLI (this is crucial for proper entrypoint)
    RUN cd /home/neuro/bidspm && \
        pip install --no-cache-dir --break-system-packages . && \
        echo "✅ BIDSPM Python CLI installed"

    # Pre-install the MACS toolbox (needed for BMS/bidsModelSelection).
    # bidspm.m's updateMacstoolbox() lazily does exactly this same
    # `git clone lib/MACS -> spm('dir')/toolbox/MACS` at runtime on first
    # use, from the submodule already fetched above -- but /opt/spm isn't
    # writable by the arbitrary host uid containers run as (see
    # build_docker_command's --user), so that lazy install fails silently
    # and BMS never works. Do it now, while still root.
    RUN git clone /home/neuro/bidspm/lib/MACS /opt/spm/toolbox/MACS && \
        chown -R neuro:neuro /opt/spm/toolbox/MACS && \
        echo "✅ MACS toolbox pre-installed"

    # updateMacstoolbox() also runs `git -C <target> pull` on every startup
    # to check for updates, even though the toolbox is already present --
    # same dubious-ownership issue as the main bidspm clone above.
    RUN git config --system --add safe.directory /opt/spm/toolbox/MACS && \
        git config --system --add safe.directory '*' && \
        chmod -R a+rwX /opt/spm/toolbox/MACS

# Bake in locally-patched bidspm files (fixes for upstream container v4.0.0
# bugs; see bidspm_overrides/README.md for the rationale behind each file).
# bidspm_overrides/ mirrors the /home/neuro/bidspm tree 1:1.
COPY bidspm_overrides/ /home/neuro/bidspm/

# Set up Octave paths with SPM and BIDSPM (simplified to avoid atlas issues)
RUN octave --no-gui --eval "addpath('/opt/spm/'); savepath('/usr/share/octave/site/m/startup/octaverc');" && \
    octave --no-gui --eval "cd('/home/neuro/bidspm'); addpath(pwd); savepath('/usr/share/octave/site/m/startup/octaverc');" && \
    echo "warning('off', 'Octave:shadowed-function'); warning('off', 'Octave:deprecated-function'); warning('off', 'Octave:legacy-function');" >> /usr/share/octave/site/m/startup/octaverc && \
    echo "✅ Octave paths configured successfully"

# Fix ownership and add to PATH
RUN chown -R neuro:neuro /home/neuro && chmod -R a+rX /home/neuro

# Switch to neuro user
USER neuro
WORKDIR /home/neuro
ENV PATH="/home/neuro/.local/bin:$PATH"

# Test Octave and core functionality
RUN octave --no-gui --eval "version; pkg list; disp('✅ Modern Octave ready!');"

# Test SPM installation
RUN octave --no-gui --eval "addpath('/opt/spm'); try; spm('defaults', 'fmri'); disp('✅ SPM working!'); catch e; disp(['⚠️ SPM issue: ' e.message]); end"

# Use original BIDSPM entrypoint design
ENTRYPOINT ["bidspm"]
CMD ["--help"]